#include <stdio.h>
#define MAX 5

int q[MAX],front=-1,rear=-1;

void enqueue(int x) {
    if(rear==MAX-1)
        printf("Queue Full\n");
    else {
        if(front==-1) front=0;
        q[++rear]=x;
    }
}

void dequeue() {
    if(front==-1 || front>rear)
        printf("Queue Empty\n");
    else
        printf("Deleted: %d\n",q[front++]);
}

void display() {
    int i;
    if(front==-1 || front>rear)
        printf("Queue Empty\n");
    else
        for(i=front;i<=rear;i++)
            printf("%d ",q[i]);
}

int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);
    display();
    printf("\n");
    dequeue();
    display();
    return 0;
}
