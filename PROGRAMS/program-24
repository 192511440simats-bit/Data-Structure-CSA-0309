#include <stdio.h>
#define INF 9999

int main() {
    int a[10][10],selected[10]={0};
    int n,i,j,edges=0,min,x,y,cost=0;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&a[i][j]);

    selected[0]=1;

    while(edges<n-1) {
        min=INF;

        for(i=0;i<n;i++)
            if(selected[i])
                for(j=0;j<n;j++)
                    if(!selected[j] && a[i][j]<min) {
                        min=a[i][j];
                        x=i;
                        y=j;
                    }

        printf("%d - %d : %d\n",x,y,min);
        cost+=min;
        selected[y]=1;
        edges++;
    }

    printf("Minimum Cost = %d",cost);
    return 0;
}
