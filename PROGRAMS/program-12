#include <stdio.h>
#include <ctype.h>

char stack[100];
int top=-1;

int priority(char c) {
    if(c=='+' || c=='-') return 1;
    if(c=='*' || c=='/') return 2;
    return 0;
}

int main() {
    char exp[100],c;
    int i;

    printf("Enter infix expression: ");
    scanf("%s",exp);

    for(i=0;exp[i]!='\0';i++) {
        c=exp[i];

        if(isalnum(c))
            printf("%c",c);
        else if(c=='(')
            stack[++top]=c;
        else if(c==')') {
            while(top!=-1 && stack[top]!='(')
                printf("%c",stack[top--]);
            top--;
        }
        else {
            while(top!=-1 && priority(stack[top])>=priority(c))
                printf("%c",stack[top--]);
            stack[++top]=c;
        }
    }

    while(top!=-1)
        printf("%c",stack[top--]);

    return 0;
}
